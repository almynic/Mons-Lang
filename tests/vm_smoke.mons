// Consumed by `./mons --vm-test` via the `use` resolver (`stdlib/core.mons`).
// `tests/smoke.mons` stays self-contained; `tests/stdlib_core.mons` typechecks stdlib alone.
use stdlib::core;

pub const K: int = 7;
pub const FLAG: bool = true;

pub fn smoke() -> int {
    let base = K;
    let f = |x: int| x + base;
    f(7)
}

pub fn smoke_use_stdlib() -> int {
    twice(6)
}

pub fn smoke_stdlib_helpers() -> int {
    let a = abs_i(-11);
    let b = clamp_i(5, 0, 10);
    let c = square(3);
    let d = mul(sub(max_int(7, 4), min_int(3, 8)), 2);
    a + b + c + d
}

pub fn mk_adder() -> fn(int) -> int {
    |y: int| y + K
}

pub fn smoke_hof() -> int {
    let f = mk_adder();
    f(5)
}

pub fn mk_adder2() -> fn(int) -> int {
    let base = K;
    |y: int| y + base
}

pub fn smoke_hof_capture() -> int {
    let f = mk_adder2();
    f(10)
}

/* Inferred lambda params + empty-param closure (bytecode parity with interpreter). */
pub fn smoke_infer_unary() -> int {
    let f = |n| n + 1;
    f(41)
}

pub fn smoke_infer_pair() -> int {
    let add = |a, b| a + 0 + b;
    add(40, 2)
}

pub fn smoke_pipe_closure() -> int {
    let x = 12;
    let d = || x;
    d()
}

pub fn smoke_nested() -> int {
    let outer = |a: int| {
        let inner = |b: int| a + b;
        inner(3)
    };
    outer(10)
}

pub fn smoke_ctrl() -> int {
    let a = if 1 < 0 { 10 } else { 20 };
    let b = if a == 20 && 1 == 1 { 3 } else { 0 };
    let c = if false || true { b + 1 } else { 0 };
    let d = if false { 0 } else if true { 5 } else { 9 };
    if !false { a + c + d } else { 0 }
}

pub fn smoke_if_return_then() -> int {
    if true { return 10; } else { 20 }
}

pub fn smoke_if_return_else() -> int {
    if false { return 10; } else { return 20; }
}

pub fn smoke_if_return_mixed() -> int {
    if true { return 5; } else { 10 }
}

pub fn smoke_assign() -> int {
    let mut x = 1;
    x = x + 4;
    x
}

pub fn smoke_assign_capture() -> int {
    let mut n = 0;
    let f = |d: int| {
        n = n + d;
        n
    };
    f(3) + f(2)
}

pub fn smoke_block_expr() -> int {
    let x = { let y = 10; y + y };
    let z = if FLAG { 2 } else { 0 };
    x + z
}

struct VmPoint {
    x: int,
    y: int,
}

impl VmPoint {
    fn sum(self: VmPoint) -> int {
        self.x + self.y
    }
}

pub fn smoke_struct() -> int {
    let p = VmPoint { x: 30, y: 12, };
    p.sum()
}

fn vm_point_xy() -> VmPoint {
    VmPoint { x: 5, y: 7, }
}

pub fn smoke_struct_field_named() -> int {
    vm_point_xy().x + vm_point_xy().y
}

pub fn smoke_struct_spread() -> int {
    let p = VmPoint { x: 3, y: 4, };
    let q = VmPoint { x: 10, ..p, };
    q.x + q.y
}

pub fn smoke_for_sum() -> int {
    let a = [1, 2, 3, 4];
    let mut s = 0;
    for x in a {
        s = s + x;
    };
    s
}

pub fn smoke_array_index() -> int {
    let a = [10, 20, 30];
    a[0] + a[2]
}

pub fn smoke_tuple_index() -> int {
    let t = (3, 5, 7);
    (10, 1)[0] + t[0] * t[1]
}

pub fn smoke_float_sum() -> float {
    2.5f + 2.5f
}

pub fn smoke_double_half() -> double {
    10.0 / 2.0
}

pub fn smoke_for_tuple_sum() -> int {
    let t = (1, 2, 3);
    let mut s = 0;
    for x in t {
        s = s + x;
    };
    s
}

pub fn smoke_match_bool() -> int {
    let b = true;
    match b {
        false => 0,
        true => 7,
    }
}

pub fn smoke_match_int() -> int {
    match 3 {
        0 => 0,
        n => n + 10,
    }
}

pub fn smoke_match_option_none() -> int {
    let x = None;
    match x {
        Option::None => 2,
        _ => 0,
    }
}

trait VmBumpTrait {
    fn vm_bump(self: VmBumpCounter) -> int;
}

struct VmBumpCounter {
    n: int,
}

impl VmBumpTrait for VmBumpCounter {
    fn vm_bump(self: VmBumpCounter) -> int {
        self.n + 1
    }
}

pub fn smoke_trait_bump() -> int {
    let c = VmBumpCounter { n: 4, };
    c.vm_bump()
}


fn vm_throw_int() -> int {
    try {
        throw 11;
    } catch (e: int) {
        throw e;
    };
    0
}

pub fn smoke_try_catch_basic() -> int {
    let mut out = 0;
    try {
        throw 9;
    } catch (e: int) {
        out = e;
    };
    out
}

pub fn smoke_try_catch_cross_call() -> int {
    let mut out = 1;
    try {
        vm_throw_int();
    } catch (e: int) {
        out = e + 1;
    };
    out
}

pub fn smoke_try_finally() -> int {
    let mut x = 2;
    try {
        x = 4;
    } catch (e: int) {
        x = e;
    } finally {
        x = x + 3;
    };
    x
}

pub fn smoke_try_catch_finally() -> int {
    let mut x = 1;
    try {
        throw 7;
    } catch (e: int) {
        x = e + 1;
    } finally {
        x = x * 2;
    };
    x
}


pub fn smoke_try_return() -> int {
    try {
        return 40;
    } catch (e: int) {
        0
    } finally {
        let _k = 1;
    };
    0
}

pub fn smoke_try_return_overridden_by_finally_throw() -> int {
    let mut y = 0;
    try {
        try {
            return 5;
        } catch (e: int) {
            0
        } finally {
            throw 9;
        };
    } catch (e: int) {
        y = e;
    };
    y
}

pub fn smoke_try_return_caught_after_finally_throw() -> int {
    let mut x = 0;
    try {
        try {
            return 5;
        } catch (e: int) {
            0
        } finally {
            throw 9;
        };
        1
    } catch (e: int) {
        x = e;
        x
    };
    x
}
