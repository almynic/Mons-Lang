// Parse + typecheck: lambdas and captures (evaluated in embedded demo / REPL).

pub fn closure_ty_ok() -> int {
    let x = 3;
    let d = || x * 2;
    d()
}

pub fn nested_lambda_ok() -> int {
    let outer = |a: int| {
        let inner = |b: int| a + b;
        inner(3)
    };
    outer(10)
}

pub fn infer_lambda_ok() -> int {
    let f = |n| n + 1;
    f(9)
}

pub fn infer_two_params_ok() -> int {
    let add = |a, b| a + 0 + b;
    add(3, 4)
}

pub fn if_return_ok() -> int {
    if true { return 3; } else { 4 }
}

pub fn ctrl_flow_ok() -> int {
    if true && !false { 1 } else { 0 }
}

pub fn assign_ok() -> int {
    let mut x = 1;
    x = x + 4;
    x
}

pub fn block_expr_ok() -> int {
    let x = { let a = 6; a + a };
    x
}

/* All-caps const + `if NAME {` must parse as cond, not struct literal (parser.c). */
pub const SMOKE_FLAG: bool = true;

pub fn if_allcaps_bool_cond() -> int {
    if SMOKE_FLAG { 7 } else { 0 }
}

pub fn match_int_ok() -> int {
    match 3 {
        0 => 0,
        n => n + 10,
    }
}

pub fn match_or_int_ok() -> int {
    match 2 {
        0 | 1 => 5,
        n => n,
    }
}

pub fn try_catch_int_ok() -> int {
    let mut r = 0;
    try {
        throw 7;
    } catch (e: int) {
        r = e + 2;
    };
    r
}

pub fn try_string_catch_ok() -> int {
    let mut n = 0;
    try {
        throw "x";
    } catch (s: string) {
        n = 3;
    };
    n
}

pub fn nested_try_ok() -> int {
    let mut out = 0;
    try {
        try {
            throw 3;
        } catch (a: int) {
            throw a + 1;
        };
    } catch (b: int) {
        out = b + 10;
    };
    out
}
